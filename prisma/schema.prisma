// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model RoleDefinition {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions RolePermission[]
}

model RolePermission {
  id               String         @id @default(cuid())
  roleDefinitionId String
  featureKey       String
  allowed          Boolean        @default(false)
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)

  @@unique([roleDefinitionId, featureKey])
  @@index([roleDefinitionId])
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  /// Unique sign-in name for students; optional for other roles.
  username    String?  @unique
  password    String
  /// When true, user must set a new password before using the portal.
  mustChangePassword Boolean @default(false)
  passwordChangedAt  DateTime?
  /// Stored role code; must match an existing `RoleDefinition.code`.
  role        String   @default("STUDENT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]  @relation("CreatedUsers")
  /// Educators are assigned to one subject catalog entry.
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  /// Public URL path e.g. /uploads/avatars/{id}.jpg or Vercel Blob URL
  avatarUrl   String?  @db.LongText
  passwordResetTokens      PasswordResetToken[]
  sessions                 ExperimentSession[]
  quizAttempts             QuizAttempt[]
  reports                  Report[]
  questionnaireSubmissions QuestionnaireSubmission[]

  @@index([subjectId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Experiment {
  id               String   @id @default(cuid())
  title            String
  description      String   @db.Text
  learningOutcome  String   @db.Text
  steps            Json
  createdAt        DateTime @default(now())
  subjectId        String?
  subject          Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  /// Max marks for the quiz component of the final grade.
  gradeQuizMax           Int @default(30)
  /// Max marks for the questionnaire component of the final grade.
  gradeQuestionnaireMax  Int @default(35)
  /// Max marks for the written report component of the final grade.
  gradeReportMax         Int @default(35)
  sessions         ExperimentSession[]
  quizzes          Quiz[]
  reports          Report[]
  questionnaire    ExperimentQuestionnaire?
  reportAssignment ExperimentReportAssignment?

  @@index([subjectId])
}

model ExperimentSession {
  id           String    @id @default(cuid())
  studentId    String
  experimentId String
  timeTaken    Int       @default(0)
  wrongSteps   Int       @default(0)
  passed       Boolean   @default(false)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  student      User       @relation(fields: [studentId], references: [id])
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  wrongStepLogs WrongStepLog[]
  questionnaireSubmission QuestionnaireSubmission?
  report                  Report?
}

model WrongStepLog {
  id          String   @id @default(cuid())
  sessionId   String
  stepNumber  Int
  description String   @db.Text
  loggedAt    DateTime @default(now())
  session     ExperimentSession @relation(fields: [sessionId], references: [id])
}

model Quiz {
  id               String         @id @default(cuid())
  experimentId     String
  title            String
  description      String         @default("") @db.Text
  passMark         Int            @default(60)
  timeLimit        Int?
  attemptsAllowed  Int            @default(1)
  shuffleQuestions Boolean        @default(false)
  isPublished      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  experiment       Experiment     @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  quizQuestions    QuizQuestion[]
  attempts         QuizAttempt[]

  @@index([experimentId])
  @@index([experimentId, isPublished])
}

enum QuizQuestionType {
  MCQ
  TRUE_FALSE
}

model QuizQuestion {
  id           String           @id @default(cuid())
  quizId       String
  questionText String           @db.Text
  questionType QuizQuestionType
  points       Int              @default(1)
  displayOrder Int              @default(0)
  quiz         Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options      QuizOption[]
  answers      QuizAnswer[]

  @@index([quizId, displayOrder])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  optionText String       @db.Text
  isCorrect  Boolean      @default(false)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selections QuizAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id          String       @id @default(cuid())
  studentId   String
  quizId      String
  score       Int
  totalPoints Int
  percentage  Int
  passed      Boolean      @default(false)
  /// Teacher-assigned marks for this attempt (counts toward experiment quiz total).
  marksAwarded   Int?
  marksMax       Int?
  marksAwardedAt DateTime?
  marksAwardedById String?
  /// Legacy JSON snapshot; prefer `quizAnswers` for new attempts.
  answers     Json?
  attemptedAt DateTime     @default(now())
  student     User         @relation(fields: [studentId], references: [id])
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizAnswers QuizAnswer[]

  @@index([quizId])
  @@index([studentId])
  @@index([quizId, studentId])
}

model QuizAnswer {
  id               String       @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean      @default(false)
  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuizOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@index([questionId])
}

/// Teacher-defined written report assignment (one per experiment).
model ExperimentReportAssignment {
  id           String   @id @default(cuid())
  experimentId String   @unique
  title        String
  instructions String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  reports      Report[]
}

model Report {
  id              String                    @id @default(cuid())
  studentId       String
  experimentId    String
  assignmentId    String
  content         String                    @db.Text
  submittedAt     DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  reviewStatus    QuestionnaireReviewStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedById    String?
  teacherFeedback String?                   @db.Text
  feedbackAt      DateTime?
  marksAwarded    Int?
  marksMax        Int?
  sessionId       String?                   @unique
  student         User                      @relation(fields: [studentId], references: [id])
  experiment      Experiment                @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  assignment      ExperimentReportAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  session         ExperimentSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([studentId, experimentId])
  @@index([assignmentId])
  @@index([reviewStatus])
}

/// Admin-defined post-VR practical questionnaire (one per experiment).
model ExperimentQuestionnaire {
  id           String   @id @default(cuid())
  experimentId String   @unique
  title        String
  sections     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  submissions  QuestionnaireSubmission[]
}

enum QuestionnaireReviewStatus {
  PENDING
  COMPLETED
}

model QuestionnaireSubmission {
  id              String    @id @default(cuid())
  studentId       String
  questionnaireId String
  sessionId       String?   @unique
  answers         Json
  submittedAt     DateTime  @default(now())
  reviewStatus    QuestionnaireReviewStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedById    String?
  scores          Json?
  scoredAt        DateTime?
  marksAwarded    Int?
  marksMax        Int?
  student         User      @relation(fields: [studentId], references: [id])
  questionnaire   ExperimentQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  session         ExperimentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([studentId, questionnaireId])
  @@index([questionnaireId])
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

model Subject {
  id          String        @id @default(cuid())
  /// Short identifier shown in schedules and catalogs (unique).
  code        String        @unique
  name        String
  status      SubjectStatus @default(ACTIVE)
  description String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  experiments Experiment[]
  teachers    User[]

  @@index([status])
}
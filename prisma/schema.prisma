// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model RoleDefinition {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions RolePermission[]
}

model RolePermission {
  id               String         @id @default(cuid())
  roleDefinitionId String
  featureKey       String
  allowed          Boolean        @default(false)
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)

  @@unique([roleDefinitionId, featureKey])
  @@index([roleDefinitionId])
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  /// Stored role code; must match an existing `RoleDefinition.code`.
  role        String   @default("STUDENT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]  @relation("CreatedUsers")
  sessions     ExperimentSession[]
  quizAttempts QuizAttempt[]
  reports      Report[]
}

model Experiment {
  id               String   @id @default(cuid())
  title            String
  description      String   @db.Text
  learningOutcome  String   @db.Text
  steps            Json
  createdAt        DateTime @default(now())
  subjectId        String?
  subject          Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sessions         ExperimentSession[]
  quizzes          Quiz[]
  reports          Report[]

  @@index([subjectId])
}

model ExperimentSession {
  id           String    @id @default(cuid())
  studentId    String
  experimentId String
  timeTaken    Int       @default(0)
  wrongSteps   Int       @default(0)
  passed       Boolean   @default(false)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  student      User       @relation(fields: [studentId], references: [id])
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  wrongStepLogs WrongStepLog[]
}

model WrongStepLog {
  id          String   @id @default(cuid())
  sessionId   String
  stepNumber  Int
  description String   @db.Text
  loggedAt    DateTime @default(now())
  session     ExperimentSession @relation(fields: [sessionId], references: [id])
}

model Quiz {
  id           String   @id @default(cuid())
  title        String
  experimentId String
  questions    Json
  createdAt    DateTime @default(now())
  experiment   Experiment    @relation(fields: [experimentId], references: [id])
  attempts     QuizAttempt[]
}

model QuizAttempt {
  id             String   @id @default(cuid())
  studentId      String
  quizId         String
  score          Int
  totalQuestions Int
  answers        Json
  attemptedAt    DateTime @default(now())
  student        User @relation(fields: [studentId], references: [id])
  quiz           Quiz @relation(fields: [quizId], references: [id])
}

model Report {
  id              String    @id @default(cuid())
  studentId       String
  experimentId    String
  content         String    @db.Text
  submittedAt     DateTime  @default(now())
  teacherFeedback String?   @db.Text
  feedbackAt      DateTime?
  student         User       @relation(fields: [studentId], references: [id])
  experiment      Experiment @relation(fields: [experimentId], references: [id])
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

model Subject {
  id          String        @id @default(cuid())
  /// Short identifier shown in schedules and catalogs (unique).
  code        String        @unique
  name        String
  status      SubjectStatus @default(ACTIVE)
  description String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  experiments Experiment[]

  @@index([status])
}
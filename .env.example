# MySQL connection (Prisma)
# Create database: CREATE DATABASE vrsps_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root:YOURPASSWORD@localhost:3306/vrsps_db"

# NextAuth v5 — set AUTH_SECRET (preferred) or NEXTAUTH_SECRET
AUTH_SECRET="your-secret-key-here"
NEXTAUTH_SECRET="your-secret-key-here"
# Use the same host you open in the browser (localhost or your LAN IP).
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
UNITY_API_KEY="your-unity-api-key-here"
# Optional: VR access token lifetime in seconds (default 28800 = 8 hours)
# UNITY_VR_TOKEN_TTL_SECONDS="28800"

# Gmail — password reset emails (use a Google App Password, not your normal Gmail password)
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
EMAIL_FROM="VRSPS <you@gmail.com>"

# Vercel Blob — required for profile picture uploads in production (read/write token from Vercel dashboard)
# Storage → Create Blob store → connect to project (auto-sets BLOB_READ_WRITE_TOKEN on Vercel)
BLOB_READ_WRITE_TOKEN=""
